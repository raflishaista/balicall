# Optional worker-side config: copy to $SEA_ASR_ROOT/sea-diarization.env (mode 600).
# Reuse the intended authentication key of the existing Nemotron service.
# Do not invent a new key here unless the diarizer is configured with that key.
SEA_LIVE_DIARIZATION_ENABLED=true
SEA_DIAR_STREAM_URL=ws://127.0.0.1:8009/asr
SEA_DIAR_HEALTH_URL=http://127.0.0.1:8009/health
SEA_DIAR_STREAM_SECRET=
