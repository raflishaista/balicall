PORT=3001
LIVEKIT_URL=ws://10.17.101.232:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=c35dce5eb68185c1ba3b140ab408da916a75c0d297f42c96cbbe5aa362f7b082

# LLM Provider Configuration
# Options: "office" | "gemini" | "demo"
LLM_PROVIDER=office

# Speech-to-Text Configuration
# Options: "browser" (Default: Web Speech API gratis bawaan browser) | "server" (Whisper / Server STT)
STT_PROVIDER=browser
# Untuk Local Whisper:
# STT_PROVIDER=server
# STT_BASE_URL=http://127.0.0.1:8000/v1
# STT_MODEL=openai/whisper-small
# STT_API_KEY=

# Office LLM Configuration (Internal Bali Tower Gateway)
LLM_KEY=
LLM_API_KEY=
LLM_BASE_URL=http://10.7.1.21/v1
LLM_MODEL=qwen-35b
TEXT_MODEL=qwen-35b
LLM_TIMEOUT_MS=60000
# Office only: at most 2 retries (3 attempts), exponential delay, 120s total budget.
LLM_RETRY_COUNT=2
LLM_RETRY_DELAY_MS=500
LLM_RETRY_BUDGET_MS=120000
# Delay auto-summary after signed room_finished so pending speech uploads can finish.
ATTENDANCE_FINALIZE_GRACE_MS=10000

# Fallback / Alternative Google Gemini
GEMINI_API_KEY=

# Optional multi-model/diarization worker (server/speech), separate from main's port 8000 server.
# Start with start_whisper.bat --models; configure Node to use port 8001 instead.
# STT_PROVIDER=server
# STT_BASE_URL=http://127.0.0.1:8001/v1
# STT_MODEL=small
# Enable small-id only after configuring WHISPER_SMALL_ID_PATH on Python.
# STT_MODELS=small,small-id
# STT_API_KEY=
# STT_DIARIZATION=true
# STT_TIMEOUT_MS=30000

# PostgreSQL Database Connection URL
DATABASE_URL=

# Login BaliCall: opt-in after running npm run auth:migrate and provisioning accounts.
# Keep false until Person 2 enables login for the target deployment.
AUTH_ENABLED=false
# Web Push: generate once with server/scripts/push-keys.js and keep private key private.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Use true with HTTPS for production; false is only for local development.
AUTH_COOKIE_SECURE=false

# Optional WhisperLiveKit streaming (separate worker on localhost:8003)
LIVE_STT_URL=
LIVE_STT_SECRET=
