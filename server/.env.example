PORT=3001
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# LLM Provider Configuration
# Options: "office" | "gemini" | "demo"
LLM_PROVIDER=office

# Office LLM Configuration (Internal Bali Tower Gateway)
# Terima LLM_KEY maupun LLM_API_KEY sebagai nama kunci
LLM_KEY=
LLM_API_KEY=
LLM_BASE_URL=http://10.7.1.21/v1
LLM_MODEL=qwen-35b
TEXT_MODEL=qwen-35b

# Fallback / Alternative Google Gemini
GEMINI_API_KEY=

# Optional: Outbound Webhook for AI Meeting Minutes (e.g. ERP, Teams, Telegram, Slack)
OUTBOUND_WEBHOOK_URL=

# PostgreSQL Database Connection (jds3_db on 10.17.101.232)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://jds3:YOUR_PASSWORD@10.17.101.232:5432/jds3_db