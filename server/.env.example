# Local development. Copy to .env and fill private values on your machine.
PORT=3001
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# office | gemini | demo; demo avoids external LLM requests.
LLM_PROVIDER=demo
LLM_KEY=
LLM_API_KEY=
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=qwen-35b
TEXT_MODEL=qwen-35b
LLM_TIMEOUT_MS=30000
GEMINI_API_KEY=

# Leave blank for local testing. Never commit a real database connection string.
DATABASE_URL=
VERIFY_EMPLOYEE_ID=false

STT_PROVIDER=browser
STT_BASE_URL=
STT_MODEL=
STT_API_KEY=
