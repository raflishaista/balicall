PORT=3001
LIVEKIT_URL=ws://127.0.0.1:7880
# Browser-facing URL above. For LAN/HTTPS, use the real ws/wss server address.
# Backend reachability checks may use a separate internal HTTP/WS address.
LIVEKIT_INTERNAL_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
CORS_ORIGINS=http://localhost:5187,http://127.0.0.1:5187

# Persistent storage defaults to server/data/meetings.json.
# Use an absolute path to override; run only one backend against each file.
MEETING_DATA_FILE=

# Speech-to-text is separate from the LLM used for meeting summaries.
# browser = Web Speech API; server = configured audio/transcriptions service.
STT_PROVIDER=browser
# Example base URL shape: http://your-stt-host:8000/v1
# Do not set this to the Qwen chat endpoint unless it also supports audio STT.
STT_BASE_URL=
STT_MODEL=
STT_API_KEY=
STT_TIMEOUT_MS=20000

# LLM Provider Configuration
# Options: "office" | "gemini" | "demo"
LLM_PROVIDER=office

# Office LLM Configuration (Internal Bali Tower Gateway)
# Terima LLM_KEY maupun LLM_API_KEY sebagai nama kunci
LLM_KEY=
LLM_API_KEY=
LLM_BASE_URL=http://10.7.1.21/v1
LLM_MODEL=qwen-35b
TEXT_MODEL=qwen-35b
LLM_TIMEOUT_MS=30000

# Fallback / Alternative Google Gemini
GEMINI_API_KEY=
