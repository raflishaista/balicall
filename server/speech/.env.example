# Set in the shell before starting uvicorn; this file is not automatically loaded.
WHISPER_MODEL=small
# Path to the CTranslate2 conversion of anggiatm/whisper-small-id.
WHISPER_SMALL_ID_PATH=
SPEECH_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
WHISPER_CPU_THREADS=4
# Use 2 and preload true to trade extra RAM for faster model switching.
WHISPER_MODEL_CACHE_SIZE=1
WHISPER_PRELOAD_MODELS=false
# Must match STT_API_KEY in the Node server when configured.
SPEECH_API_KEY=
# Accept https://huggingface.co/pyannote/speaker-diarization-community-1 first.
HF_TOKEN=
