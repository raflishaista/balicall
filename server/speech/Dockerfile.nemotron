FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app

RUN pip install torch torchaudio --index-url https://download.pytorch.org/whl/cpu
RUN pip install "transformers>=5.18" librosa numpy fastapi "uvicorn>=0.30,<1"

COPY nemotron_app.py ./

EXPOSE 8007
CMD ["python", "-m", "uvicorn", "nemotron_app:app", "--host", "0.0.0.0", "--port", "8007"]