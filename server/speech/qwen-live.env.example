# Copy to .env.qwen-live on the Linux server and chmod 600.
QWEN_PYTHON=/var/tmp/balicall-qwen-live-jds3-20261020/qwen-venv/bin/python
NEMOTRON_PYTHON=/var/tmp/balicall-qwen-live-jds3-20261020/nemotron-venv/bin/python
QWEN_MODEL_PATH=/var/tmp/balicall-qwen-live-jds3-20261020/qwen-model
NEMOTRON_MODEL_PATH=/var/tmp/balicall-qwen-live-jds3-20261020/nemotron-model
QWEN_GPU_MEMORY_UTILIZATION=0.25
NEMOTRON_DEVICE=cuda
QWEN_LIVE_STT_SECRET=
QWEN_DIAR_STREAM_SECRET=
QWEN_DIAR_STREAM_URL=ws://127.0.0.1:8009/asr
QWEN_DIAR_HEALTH_URL=http://127.0.0.1:8009/health
HF_HUB_OFFLINE=1
# Node server/.env uses the same QWEN_LIVE_STT_SECRET, plus:
# QWEN_LIVE_STT_URL=/qwen-live-stt/asr
# QWEN_LIVE_HEALTH_URL=http://127.0.0.1:8008/health

# Worker admission limit (1-8). Increase only after real GPU latency/load QC.
QWEN_LIVE_MAX_SESSIONS=2
