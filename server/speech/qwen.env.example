# Export these variables before starting uvicorn; this file is not auto-loaded.
SPEECH_DEVICE=cpu
QWEN_CPU_THREADS=4
# CPU defaults to float32; tested bfloat16 can reduce RAM on compatible CPUs.
# GPU defaults to float16. Check accuracy/performance on target hardware.
QWEN_DTYPE=float32
# One inference plus three waiting requests; overload can require retry.
QWEN_MAX_PENDING=3
QWEN_QUEUE_WAIT_SECONDS=30
QWEN_MODEL_PATH=Qwen/Qwen3-ASR-0.6B
QWEN_MODEL_REVISION=5eb144179a02acc5e5ba31e748d22b0cf3e303b0
QWEN_LOCAL_FILES_ONLY=false
# Set the same private key as Node's QWEN_STT_API_KEY; required in production.
SPEECH_API_KEY=
# Keep loopback binding. Run in a separate venv:
# pip install -r qwen_requirements.txt
# python -m uvicorn qwen_app:app --host 127.0.0.1 --port 8006
# Node config: QWEN_STT_BASE_URL=http://127.0.0.1:8006/v1
# Experimental speaker-turn adapter (optional; UI remains locked pending real QC).
# Full endpoint of the existing standalone Nemotron/pyannote diarization service:
QWEN_DIARIZATION_URL=
QWEN_DIARIZATION_API_KEY=
# Existing service limit. Raising this does not raise the remote service limit.
QWEN_DIARIZATION_MAX_SECONDS=60
# Whole-recording Nemotron worker (raw PCM /v1/diarize, not streaming /asr).
# Keep this worker separate from the live GPU workload.
QWEN_BATCH_NEMOTRON_URL=
QWEN_BATCH_NEMOTRON_KEY=
QWEN_BATCH_NEMOTRON_TIMEOUT=1800
# Backend opt-in for explicit API tests only: QWEN_DIARIZATION_ENABLED=true
