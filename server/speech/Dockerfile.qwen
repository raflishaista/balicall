FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 HF_HOME=/cache/hf
WORKDIR /app

RUN pip install torch --index-url https://download.pytorch.org/whl/cpu
COPY qwen_requirements.txt .
RUN pip install -r qwen_requirements.txt

COPY qwen_app.py qwen_diarization.py qwen_batch.py ./

EXPOSE 8006
CMD ["python", "-m", "uvicorn", "qwen_app:app", "--host", "0.0.0.0", "--port", "8006"]
